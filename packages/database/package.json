{
  "name": "@workspace/netsleuth-database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "lint": "eslint . --config ../config/eslint.config.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "build": "tsc",
    "test:db": "tsx --test tests/constraints.test.ts",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "@workspace/netsleuth-config": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.0",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
