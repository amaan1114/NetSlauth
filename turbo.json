{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV"],
      "passThroughEnv": ["PORT", "HOST"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "HOST", "DATABASE_URL", "NODE_ENV", "CORS_ORIGINS", "JWT_ACCESS_SECRET", "JWT_REFRESH_SECRET", "JWT_ACCESS_TTL_SECONDS", "JWT_REFRESH_TTL_SECONDS", "COOKIE_SECURE", "COOKIE_SAME_SITE", "COOKIE_DOMAIN"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["CI", "NODE_ENV"],
      "passThroughEnv": ["DATABASE_URL", "CORS_ORIGINS", "JWT_ACCESS_SECRET", "JWT_REFRESH_SECRET", "COOKIE_SECURE", "COOKIE_SAME_SITE", "COOKIE_DOMAIN"]
    }
  }
}
