{
  "name": "@workspace/netsleuth-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --config ../../packages/config/eslint.config.mjs",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test --test-timeout=30000 tests/*.test.ts",
    "test:e2e": "tsx --test --test-timeout=60000 tests/integration/*.test.ts"
  },
  "dependencies": {
    "@workspace/netsleuth-database": "workspace:*",
    "@workspace/netsleuth-shared": "workspace:*",
    "express": "^5.1.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.2.0",
    "cors": "^2.8.6",
    "helmet": "^8.1.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "catalog:",
    "socket.io": "^4.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "@types/node": "catalog:",
    "@workspace/netsleuth-config": "workspace:*",
    "eslint": "^9.39.0",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
