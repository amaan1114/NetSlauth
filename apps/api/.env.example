# Required PostgreSQL URL; supply credentials securely, never commit them.
DATABASE_URL=
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated frontend origins; do not use a wildcard with credentials.
CORS_ORIGINS=http://localhost:3000
# Separate random signing secrets, at least 32 characters each. Never commit values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Defaults to true in production; cannot be false in production.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional: omit for safer host-only cookies.
# COOKIE_DOMAIN=example.com
