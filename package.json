{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "turbo run build --filter='./apps/*' --filter='./packages/*'",
    "dev": "turbo run dev --filter='./apps/*'",
    "lint": "turbo run lint --filter='./apps/*' --filter='./packages/*'",
    "test": "turbo run test --filter='./apps/*' --filter='./packages/*'",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && turbo run typecheck",
    "typecheck:netsleuth": "turbo run typecheck --filter='./apps/*' --filter='./packages/*'",
    "build:netsleuth": "pnpm run build"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
